<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dainric 打包器 · 单元测试 -->
  <!-- 作者: Dainric -->
  <!-- 覆盖：命令构造、失败诊断、文件名校验、运行时识别 -->
  <!-- 之前那三个致命 bug（EnableRaisingEvents / 参数重复 / 别名 python）
       都属于「跑起来才炸」的类型，本工程就是为了在编译期就拦住它们 -->

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>DainricPacker.Tests</AssemblyName>
    <RootNamespace>Dainric.Packer.Tests</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\打包器-C#源码\DainricPacker.csproj" />
  </ItemGroup>

</Project>
