<!-- 关于对话框 · 作者: Dainric -->
<Window x:Class="Dainric.Packer.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Dainric 打包器" Width="470" Height="430"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">

  <Border Background="{StaticResource Surface}" CornerRadius="14"
          BorderBrush="{StaticResource Hair}" BorderThickness="1">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Path Data="M6,2 L16,10 L6,18 Z" Fill="{StaticResource Blue}"
              VerticalAlignment="Center"/>
        <TextBlock Text="Dainric 打包器" Style="{StaticResource H1}"
                   Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="VerTextBlock" Grid.Row="1" Text="v…"
                 Style="{StaticResource Caption}" Margin="0,8,0,0"/>

      <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                 FontFamily="{StaticResource UiFont}" FontSize="12"
                 Foreground="{StaticResource Label2}"
                 Text="把 Python 脚本打包成独立 EXE 的原生 Windows 工具。&#x0a;自带 Python 运行时，目标机无需安装任何环境。"/>

      <Border Grid.Row="3" Background="{StaticResource Surface2}" CornerRadius="10"
              Margin="0,14,0,0" Padding="12,10">
        <StackPanel>
          <TextBlock x:Name="InfoVersion" Style="{StaticResource Caption}"
                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
          <TextBlock x:Name="InfoEnv" Style="{StaticResource Caption}"
                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock x:Name="InfoOs" Style="{StaticResource Caption}"
                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock x:Name="InfoDir" Style="{StaticResource Caption}"
                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock x:Name="InfoData" Style="{StaticResource Caption}"
                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <WrapPanel Grid.Row="4" Margin="0,14,0,0">
        <Button Content="打开安装目录" Style="{StaticResource GhostButton}"
                Click="OpenInstallDir"/>
        <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                Click="OpenLogDir"/>
        <Button Content="使用说明" Style="{StaticResource GhostButton}"
                Click="OpenHelp"/>
        <Button Content="复制诊断信息" Style="{StaticResource GhostButton}"
                Click="CopyDiag"/>
      </WrapPanel>

      <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Margin="0,10,0,0"
                 TextWrapping="Wrap"
                 Text="日志目录里会保留每次打包的完整日志，反馈问题时可以直接把日志发给作者。" />

      <StackPanel Grid.Row="6" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="关闭" Style="{StaticResource SecondaryButton}"
                Click="CloseDialog" MinWidth="76"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
