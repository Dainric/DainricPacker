<!-- Dainric 打包器 · 主题资源 -->
<!-- 作者: Dainric -->
<!-- 取自 iOS 深色系统色，纯黑底 + 抬升表面 + 发丝分隔，不用描边分层 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ══ 配色 ══ -->
  <Color x:Key="BgColor">#FF000000</Color>
  <Color x:Key="SurfaceColor">#FF1C1C1E</Color>
  <Color x:Key="Surface2Color">#FF2C2C2E</Color>
  <Color x:Key="Surface3Color">#FF3A3A3C</Color>
  <Color x:Key="HairColor">#FF2A2A2C</Color>
  <Color x:Key="BlueColor">#FF0A84FF</Color>
  <Color x:Key="GreenColor">#FF30D158</Color>
  <Color x:Key="OrangeColor">#FFFF9F0A</Color>
  <Color x:Key="PinkColor">#FFFF375F</Color>
  <Color x:Key="LabelColor">#FFFFFFFF</Color>
  <Color x:Key="Label2Color">#FFA5A5AC</Color>
  <Color x:Key="Label3Color">#FF7C8798</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}"/>
  <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}"/>
  <SolidColorBrush x:Key="Hair" Color="{StaticResource HairColor}"/>
  <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
  <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
  <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}"/>
  <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}"/>
  <SolidColorBrush x:Key="Label" Color="{StaticResource LabelColor}"/>
  <SolidColorBrush x:Key="Label2" Color="{StaticResource Label2Color}"/>
  <SolidColorBrush x:Key="Label3" Color="{StaticResource Label3Color}"/>

  <!-- ══ 字体 ══ -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

  <!-- ══ 卡片 ══ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="CardFlat" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- ══ 标题 ══ -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Label}"/>
  </Style>

  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Label}"/>
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Label2}"/>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Label}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ══ 输入框：无边框，聚焦时文字变蓝并把宿主描边点亮 ══
       依赖宿主 Border 的 x:Name=InputHost，缺失时静默跳过 -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource Label}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Blue}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
    <Setter Property="SelectionOpacity" Value="0.45"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 输入框宿主：聚焦时底部亮一条，让焦点位置一眼可见 -->
  <Style x:Key="InputHost" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface2}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <!-- ══ 按钮：圆角 + 按下缩放 + 悬停变色 ══ -->
  <Style x:Key="BaseButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- 不用 RenderTransform 做按下缩放：命名 transform 在 Trigger 里
               引用时 XAML 编译器会报 MC4111。改用颜色/透明度表达按下态 -->
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="9" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.66"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{StaticResource Blue}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="18,8"/>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{StaticResource Surface2}"/>
    <Setter Property="Foreground" Value="{StaticResource Label}"/>
    <Setter Property="Padding" Value="14,7"/>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Blue}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="#26FF375F"/>
    <Setter Property="Foreground" Value="{StaticResource Pink}"/>
    <Setter Property="Padding" Value="14,7"/>
  </Style>

  <!-- 小型筛选开关：日志过滤等紧凑场合 -->
  <Style x:Key="FilterToggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource Label2}"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background"
                      Value="{StaticResource Surface2}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#330A84FF"/>
              <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ iOS 开关 ══ -->
  <Style x:Key="IosSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="track" Width="46" Height="28" CornerRadius="14"
                  Background="{StaticResource Surface3}">
            <Border x:Name="knob" Width="24" Height="24" CornerRadius="12"
                    Background="White" HorizontalAlignment="Left"
                    Margin="2,0,0,0">
              <Border.RenderTransform>
                <TranslateTransform x:Name="tt" X="0"/>
              </Border.RenderTransform>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background"
                      Value="{StaticResource Green}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="tt"
                                     Storyboard.TargetProperty="X"
                                     To="18" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="tt"
                                     Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ 侧栏导航项 ══ -->
  <Style x:Key="NavItem" TargetType="Border">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="10,9"/>
    <Setter Property="Margin" Value="8,2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- ══ 进度条 ══ -->
  <Style x:Key="ThinProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="Foreground" Value="{StaticResource Blue}"/>
    <Setter Property="Background" Value="{StaticResource Surface3}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="3"
                  ClipToBounds="True">
            <!-- 指示条宽度由右侧留白厚度控制：WPF 会按 Value 比例调整它。
                 用 HorizontalAlignment=Stretch + 右 Margin 的方式，
                 比让两个 Border 叠在同一单元格里可靠。 -->
            <Grid>
              <Border x:Name="PART_Track" Background="Transparent"
                      HorizontalAlignment="Stretch"/>
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ 滚动条：细、无箭头 ══ -->
  <Style x:Key="ThinScroll" TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#40FFFFFF" CornerRadius="4"
                              Margin="2,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ 发丝分隔线 ══ -->
  <Style x:Key="HairLine" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{StaticResource Hair}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

</ResourceDictionary>
